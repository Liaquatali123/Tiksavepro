# Server-side RapidAPI credentials. Set the real key only in Vercel Environment Variables.
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-video-no-watermark2.p.rapidapi.com

# Public canonical origin used for metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://tiksavepro.vercel.app

# Optional contact form delivery (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL=TikSave Pro <onboarding@resend.dev>
